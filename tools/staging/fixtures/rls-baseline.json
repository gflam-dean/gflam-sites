{
 "rls": {
  "vp_venues": {
   "enabled": true,
   "forced": false
  },
  "vp_members": {
   "enabled": true,
   "forced": false
  }
 },
 "policies": {
  "vp_venues.staff read": {
   "cmd": "SELECT",
   "permissive": "PERMISSIVE",
   "roles": "authenticated",
   "using": "vp_is_staff(id)",
   "with_check": ""
  },
  "vp_members.staff write": {
   "cmd": "ALL",
   "permissive": "PERMISSIVE",
   "roles": "authenticated",
   "using": "vp_is_staff_roster(roster_id)",
   "with_check": "vp_is_staff_roster(roster_id)"
  }
 },
 "grants": [
  "vp_members authenticated SELECT",
  "vp_venues anon SELECT",
  "vp_venues authenticated SELECT"
 ],
 "views": [
  "v_vp_trusted"
 ],
 "security_definer_functions": {
  "vp_is_staff(v uuid)": {
   "anon": false,
   "authenticated": true
  }
 }
}