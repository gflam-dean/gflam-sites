#!/bin/bash
# Refuse a push that would break either site.
#
# A checklist you have to remember to run is a checklist that gets skipped, and
# main deploys straight to production on a product with a live venue on it. So
# this is not a reminder, it is a gate.
#
# Install:  bash tools/hooks/install.sh

ROOT="$(git rev-parse --show-toplevel)"
# git exports GIT_DIR (and GIT_WORK_TREE, GIT_INDEX_FILE when set) to this hook, and everything the
# gate runs would inherit them. On 27 Oct 2026 a test's "throwaway" git init re-initialised THIS
# checkout's gitdir through exactly that, and its commit "three" went out in the push. ROOT is known;
# from here every git command finds the checkout from its working directory and nothing else.
cd "$ROOT" || exit 1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
echo
echo "── pre-push: checking before this goes to a live venue ──"

# THE GATE READS FILES ON DISK, SO THE DISK MUST BE WHAT IS BEING PUSHED. With an edit
# sitting uncommitted under a served or tested folder, every check below judges a tree
# that is not in the push (audit, 20 Sep 2026). Commit it or stash it first.
DIRTY=$(git status --porcelain -- venueplay partyplay venueplay-backend partyplay-backend tools 2>/dev/null | grep -v '^?? .*\.backup-' | head -8)
if [ -n "$DIRTY" ]; then
  echo
  echo "PUSH REFUSED. These files differ from the commit being pushed, so the gate"
  echo "would be judging a tree that is not going out:"
  echo "$DIRTY" | sed 's/^/    /'
  echo "Commit them, or git stash them, then push again."
  exit 1
fi

# A Worker whose stamp does not match its own contents would report a build that
# is not the one running, which is worse than no stamp at all.
if ! python3 "$ROOT/tools/stamp-workers.py" --check; then
  echo
  echo "PUSH REFUSED. A Worker changed without being restamped."
  echo "Run: python3 tools/stamp-workers.py"
  exit 1
fi

# THE CHROME HALF MAY COME FROM vp-tests-1 (12 Nov 2026, INBOX 265.4; the FAST GATE, 13 Nov 2026, INBOX 357A).
# --chrome-record leaves a Chrome suite out on this Mac ONLY when a record SIGNED ON THIS MAC covers it: this exact
# tree (git HEAD^{tree}), the server's own hash of the files it ran equal to this tree's, under 2 hours old, every
# Chrome suite green on its one and only server run and at or over its ledger count (tools/gate-server.py). No record,
# or anything wrong with one (edited, another key, another tree, stale, a suite missing or red, re-runs), and every
# Chrome suite runs here one at a time, as before. signin-logo-in-chrome always runs here. tools/release.py makes the
# record before it pushes; by hand:
#     python3 tools/gate-server.py run        (about 30 minutes; or push with VP_GATE_SERVER=1 to have this hook do it)
# A failed, refused or unreachable server run is never fatal: the gate below simply runs the Chrome suites on the Mac.
if [ "${VP_GATE_SERVER:-}" = "1" ] && [ -f "$ROOT/tools/gate-server.py" ]; then
  python3 "$ROOT/tools/gate-server.py" run || echo "  (no server record: the Chrome suites run on this Mac)"
fi

# WHAT IS PUSHED MUST BE WHAT IS HERE for a record to count. git hands this hook "<local ref> <local sha> <remote ref>
# <remote sha>" per ref. A push of any commit whose files are not this checkout's (git push origin other:main) gets
# no record: the Chrome suites run on the Mac.
CHROME_FLAG="--chrome-record"
HERE_TREE=$(git rev-parse 'HEAD^{tree}' 2>/dev/null)
while read -r _lref LSHA _rref _rsha; do
  [ -z "$LSHA" ] && continue
  case "$LSHA" in *[!0]*) ;; *) continue;; esac          # a delete pushes no files
  if [ "$(git rev-parse "$LSHA^{tree}" 2>/dev/null)" != "$HERE_TREE" ]; then
    CHROME_FLAG=""
    echo "  the push sends ${LSHA:0:8}, whose files are not this checkout's: no server record is used, every Chrome suite runs here"
  fi
  # BILLING CODE RUNS ON THE MAC TOO (Dean, 16 Nov 2026): when the pushed range changes billing code (the billing parts
  # of venueplay-api-FULL.js, Stripe code, invoices, venueplay/app/billing.html: BILLING_* in tools/gate-server.py),
  # the server record is not used and every Chrome suite runs here as well. A new branch (remote sha all zeros) is
  # judged from where it leaves origin/main; a range that cannot be read counts as billing.
  case "$_rsha" in *[!0]*) PBASE="$_rsha" ;; *) PBASE=$(git merge-base "$LSHA" origin/main 2>/dev/null) ;; esac
  if [ -n "$CHROME_FLAG" ]; then
    if [ -z "$PBASE" ] || [ ! -f "$ROOT/tools/gate-server.py" ] || python3 "$ROOT/tools/gate-server.py" billing "$PBASE" "$LSHA"; then
      CHROME_FLAG=""
      echo "  the push changes billing code (or its range could not be read): no server record is used, every Chrome suite runs here"
    fi
  fi
done

# VP_HOOK_DRY_RUN=1 (13 Nov 2026, INBOX 357A): say what the gate WOULD do with the Chrome half for this push, then
# REFUSE it. It can only ever stop a push, never let one through, and it runs no suite.
if [ "${VP_HOOK_DRY_RUN:-}" = "1" ]; then
  if [ -n "$CHROME_FLAG" ] && [ -f "$ROOT/tools/gate-server.py" ]; then
    python3 "$ROOT/tools/gate-server.py" check
  else
    echo "  gate record: not used: the pushed files are not this checkout's"
  fi
  echo "DRY RUN (VP_HOOK_DRY_RUN=1): nothing gated, PUSH REFUSED."
  exit 1
fi

if ! python3 "$ROOT/tools/release-check.py" --local $CHROME_FLAG; then
  # A red gate leaves no record: a tree that failed can never ride an older one.
  [ -f "$ROOT/tools/gate-record.py" ] && python3 "$ROOT/tools/gate-record.py" --clear
  echo
  echo "PUSH REFUSED. Fix the above. Do not fix it by deleting the check, and do not"
  echo "reach for --no-verify: a red gate is cheaper than a red venue."
  exit 1
fi

# GREEN: write down the tree this gate judged and when (tools/gate-record.json, ignored by git).
# release.py step 5 reads it and skips ONLY the Chrome suites, only when the tree it is about to
# gate is this exact tree and this record is under two hours old. The same 15 Chrome suites ran
# twice per release on the identical tree before 27 Oct 2026, 27 minutes each time.
[ -f "$ROOT/tools/gate-record.py" ] && python3 "$ROOT/tools/gate-record.py" --write

# Anything a machine cannot judge, put in front of the person pushing.
CHANGED=$(git diff --name-only @{u}..HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD)
if echo "$CHANGED" | grep -qE "(screen|play|host|tv)\.html|vp-(follow|screen-router|sign|gaming)\.js|run\.html"; then
  echo
  echo "── this push touches a game, a screen or a phone ──"
  echo "   Static checks did not catch four of the five faults found on 27 Aug,"
  echo "   because they only appear when a game is actually running. After it"
  echo "   deploys, someone has to open a screen and a phone and play one."
  echo
fi
echo "── ok, pushing ──"
echo
exit 0
